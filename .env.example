# Optional local Docker Compose overrides. Copy to .env; never commit .env.
POSTGRES_DB=airsms
POSTGRES_USER=airsms
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD

AIRSMS_DATABASE=airsms
AIRSMS_NOTIFICATIONS_DATABASE=airsms_notifications

JWT_ISSUER=AirSms.Api
JWT_AUDIENCE=AirSms.Client
JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

VITE_API_BASE_URL=http://localhost:5000
VITE_NOTIFICATIONS_API_BASE_URL=http://localhost:5001
