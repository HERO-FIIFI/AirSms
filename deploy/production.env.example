APP_DOMAIN=airsms.example.com
ASPNETCORE_ENVIRONMENT=Production

AIRSMS_API_IMAGE=airsms-api:REPLACE_WITH_IMMUTABLE_TAG
AIRSMS_NOTIFICATIONS_IMAGE=airsms-notifications:REPLACE_WITH_IMMUTABLE_TAG
AIRSMS_PROJECTIONS_IMAGE=airsms-projections-worker:REPLACE_WITH_IMMUTABLE_TAG
AIRSMS_WEB_IMAGE=airsms-web:REPLACE_WITH_IMMUTABLE_TAG

POSTGRES_DB=airsms
AIRSMS_NOTIFICATIONS_DATABASE=airsms_notifications
POSTGRES_USER=airsms
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD

KAFKA_CLUSTER_ID=REPLACE_WITH_KAFKA_CLUSTER_ID

JWT_ISSUER=https://airsms.example.com
JWT_AUDIENCE=AirSms.Client
JWT_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_ENABLE_SSL=true
SMTP_FROM_ADDRESS=notifications@airsms.example.com
SMTP_FROM_NAME=AirSms Operations

BOOTSTRAP_ADMIN_EMAIL=admin@airsms.example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=AirSms
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
