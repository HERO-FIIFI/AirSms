{
  "Jwt": {
    "SigningKey": "local-development-only-signing-key-replace-outside-development"
  },
  "Outbox": {
    "PollIntervalSeconds": 2,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "127.0.0.1:9092",
    "IncidentEventsTopic": "airsms.incident-events.v1",
    "ClientId": "airsms-api-dev",
    "ConsumerGroup": "airsms-core-projections-v1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
