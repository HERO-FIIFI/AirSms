{
  "ConnectionStrings": {
    "AirSmsDatabase": "Host=localhost;Port=5432;Database=airsms;Username=airsms;Password=airsms_dev_password"
  },
  "Jwt": {
    "Issuer": "AirSms.Api",
    "Audience": "AirSms.Client",
    "ExpirationMinutes": 60
  },
  "Outbox": {
    "PollIntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 5
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "127.0.0.1:9092",
    "IncidentEventsTopic": "airsms.incident-events.v1",
    "ClientId": "airsms-api",
    "ConsumerGroup": "airsms-core-projections-v1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
