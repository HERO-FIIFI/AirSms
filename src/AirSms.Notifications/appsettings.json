{
  "Jwt": {
    "Issuer": "AirSms.Api",
    "Audience": "AirSms.Client"
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "127.0.0.1:9092",
    "IncidentEventsTopic": "airsms.incident-events.v1",
    "ClientId": "airsms-notifications",
    "ConsumerGroup": "airsms-notifications-v1"
  },
  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "notifications@airsms.local",
    "FromName": "AirSms Operations",
    "MaxAttempts": 3,
    "PollIntervalSeconds": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
